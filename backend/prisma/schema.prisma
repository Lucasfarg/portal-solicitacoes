generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explícito: sem isso o gerador deduz o formato do tsconfig, que não existe no install do Docker.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REQUESTER
  AGENT

  @@map("user_role")
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DONE

  @@map("request_status")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  // citext: "Ana" e "ana" são o mesmo login.
  username     String   @unique @db.Citext
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(REQUESTER)
  // Desativado em vez de apagado: as solicitações e o histórico ficam.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions         Session[]
  requests         Request[]              @relation("RequestRequester")
  assignedRequests Request[]              @relation("RequestAssignee")
  statusChanges    RequestStatusHistory[]

  @@map("users")
}

model Session {
  id         Int      @id @default(autoincrement())
  // SHA-256 do token; o token em si só existe no cookie.
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id       Int     @id @default(autoincrement()) @db.SmallInt
  name     String  @unique @db.Citext
  active   Boolean @default(true)
  slaHours Int     @map("sla_hours") @db.SmallInt

  requests Request[]

  @@map("categories")
}

model Request {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(120)
  description String
  categoryId  Int           @map("category_id") @db.SmallInt
  requesterId Int           @map("requester_id")
  // Nulo só em Aberto (CHECK no banco).
  assigneeId  Int?          @map("assignee_id")
  status      RequestStatus @default(OPEN)
  // Calculado na abertura, em horas úteis.
  dueAt       DateTime      @map("due_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Exclusão lógica: a linha e o histórico ficam.
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  category  Category               @relation(fields: [categoryId], references: [id])
  requester User                   @relation("RequestRequester", fields: [requesterId], references: [id])
  assignee  User?                  @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  history   RequestStatusHistory[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([status, dueAt])
  @@index([categoryId])
  // Sem índice, apagar um usuário varreria requests para conferir o RESTRICT.
  @@index([assigneeId])
  @@map("requests")
}

model RequestStatusHistory {
  id          Int            @id @default(autoincrement())
  requestId   Int            @map("request_id")
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus  @map("to_status")
  changedById Int            @map("changed_by")
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([requestId, changedAt])
  @@map("request_status_history")
}

// No banco, e não na memória, para valer com várias instâncias da API e após reinício.
model LoginFailure {
  id       Int      @id @default(autoincrement())
  ip       String   @db.VarChar(45)
  // Exista ou não o usuário.
  username String   @db.Citext
  failedAt DateTime @map("failed_at") @db.Timestamptz(3)

  @@index([username, ip, failedAt])
  @@index([ip, failedAt])
  @@map("login_failures")
}
