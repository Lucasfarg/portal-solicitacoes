{
  "name": "portal-solicitacoes",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @portal/shared build",
    "dev:api": "pnpm --filter backend start:dev",
    "dev:web": "pnpm --filter frontend start",
    "dev:shared": "pnpm --filter @portal/shared dev",
    "lint": "biome check && pnpm --filter frontend lint",
    "format": "biome check --write && pnpm --filter frontend format",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm build:shared && pnpm --filter backend test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
