# Banco (usado pelo docker compose)
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal
PORT=3000
# Sessão: expira por inatividade (mínimo 5 min) ou pelo limite absoluto, o que vier primeiro
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# true quando o portal é servido por HTTPS: cookie de sessão com Secure e prefixo __Host-
HTTPS_ONLY=false
# Documentação interativa em /api/docs; desligar num ambiente exposto.
SWAGGER_ENABLED=true
# De onde a API aceita o X-Forwarded-For: só a própria máquina fora do compose (o compose usa
# a rede interna, onde só o nginx alcança a API).
TRUST_PROXY=loopback
# Fuso do expediente (prazo em horas úteis) e das datas do filtro, em nome IANA.
APP_TIMEZONE=America/Fortaleza
